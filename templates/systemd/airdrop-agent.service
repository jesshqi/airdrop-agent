[Unit]
Description=airdrop-agent autopilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__REPO__
Environment=AIRDROP_HOME=__HOME__/.airdrop-agent
ExecStart=__REPO__/.venv/bin/python -m aa autopilot daemon
Restart=on-failure
RestartSec=30
# journald keeps redacted output; secrets live in __HOME__/.airdrop-agent/.env
Environment=PYTHONUNBUFFERED=1
TimeoutStopSec=40

[Install]
WantedBy=default.target
