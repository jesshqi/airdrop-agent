[Unit]
Description=Airdrop agent daily check-in
After=network-online.target

[Service]
Type=oneshot
User=airdrop
WorkingDirectory=/home/airdrop/.hermes/skills/crypto/airdrop-agent
ExecStart=/home/airdrop/.hermes/skills/crypto/airdrop-agent/.venv/bin/python scripts/core/checkin_runner.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/airdrop/.airdrop-agent
