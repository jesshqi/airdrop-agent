# ~/.airdrop-agent/.env   (chmod 600, owner = user "airdrop").  NO REAL SECRETS IN GIT.
# The agent must never cat/print this file.

# --- Vault (encrypts burner keys). Long random passphrase; back it up OFFLINE.
VAULT_PASSWORD=change-me-long-random-passphrase

# --- Reporting bot -> your group forum topic
TG_REPORT_BOT_TOKEN=123456789:replace_with_botfather_token_xxxxxxxxxxx
TG_REPORT_CHAT_ID=-1001234567890
TG_REPORT_TOPIC_ID=123

# --- Telegram USER session (dedicated number) from https://my.telegram.org
TG_API_ID=1234567
TG_API_HASH=replace_me
# TG_SESSION=/home/airdrop/.airdrop-agent/vault/tg
TG_MIN_DELAY=4
TG_MAX_FLOOD_WAIT=900

# --- Agent email (dedicated Gmail w/ App Password, or your own domain IMAP)
AGENT_EMAIL=agent.example@gmail.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=agent.example@gmail.com
IMAP_PASSWORD=gmail-app-password-16chars

# --- Discord
DISCORD_BOT_TOKEN=replace_me
DISCORD_WATCH_CHANNEL_IDS=111111111111111111,222222222222222222
# Opt-in ONLY if you accept ban risk (selfbot = against Discord ToS):
# DISCORD_USER_TOKEN=
# DISCORD_USER_TOKEN_OPTIN=I_ACCEPT_BAN_RISK

# --- RPCs (private RPCs recommended; chain_id is verified on connect)
RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_BASE_SEPOLIA=https://sepolia.base.org
RPC_ARB_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
RPC_MONAD_TESTNET=

# --- Browser
BROWSER_PROFILE=main
# Unpacked extension dir(s), comma separated (Rabby recommended). Requires Xvfb on VPS.
# BROWSER_EXTENSION_DIRS=/home/airdrop/ext/rabby
# BROWSER_PROXY=http://user:pass@host:port   (only ONE stable residential IP per identity)
HUMAN_WAIT_SEC=900
TZ=Asia/Jakarta

# --- Runner
CHECKIN_JITTER_MIN=25
LOG_LEVEL=INFO
# AIRDROP_HOME=/home/airdrop/.airdrop-agent

# --- Approval via Telegram reply (optional): your personal Telegram user id (owner). Requires bot NOT polled elsewhere.
# TG_OWNER_USER_ID=123456789

# --- Discord chat role grinder (OPT-IN, violates Discord ToS — dedicated account ONLY)
# DISCORD_USER_TOKEN=
# I_ACCEPT_BAN_RISK=true
# DISCORD_SERVERS_FILE=/home/airdrop/.airdrop-agent/discord_servers.yaml
# LLM for chat (OpenAI-compatible). Examples: Alibaba Model Studio / Gemini OpenAI-compat endpoint
# GRIND_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# GRIND_LLM_API_KEY=
# GRIND_LLM_MODEL=qwen-flash
# LLM_MOCK=1          # offline canned replies for testing

# --- Radar (scripts/radar). Sources: ~/.airdrop-agent/radar_sources.yaml
# Separate Telethon session for the radar listener (one session file can't be used by 2 processes)
# TG_RADAR_SESSION=/home/airdrop/.airdrop-agent/vault/tg_radar
# X API v2 (official). App bearer token for reads — pay-per-use, budget cap in radar_sources.yaml
# X_BEARER_TOKEN=
# Follow via API needs user OAuth + Enterprise access (removed from self-serve tiers Apr 2026):
# X_API_FOLLOW_MODE=enterprise
# X_USER_ACCESS_TOKEN=
# X_USER_ID=
# Browser follow (Playwright, logged-in profile) — OPT-IN, X ToS risk:
# X_BROWSER_FOLLOW_OPTIN=I_ACCEPT_X_TOS_RISK
# X_BROWSER_PROFILE=xburner
# Optional LLM classifier (OpenAI-compatible); falls back to GRIND_LLM_* if unset
# RADAR_LLM_BASE_URL=
# RADAR_LLM_API_KEY=
# RADAR_LLM_MODEL=
# RADAR_TG_SYNC=0     # 1 = radar_runner also polls Telegram approvals (only if bot not polled elsewhere)

# --- RISK mode (DANGER). off = approval codes required (default). on = auto queue + auto execute (connect, SIWE,
# tx on testnet AND mainnet) WITHOUT approval, inside policy.yaml risk_on caps. Hard blocks stay. Toggle at runtime:
# scripts/core/risk_mode.py on|off  or Telegram "/risk on|off|status" (owner). Auto-reverts after risk_on.max_hours.
RISK_MODE=off
