<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.airdrop-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>aa</string>
    <string>autopilot</string>
    <string>daemon</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AIRDROP_HOME</key><string>__HOME__/.airdrop-agent</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>__HOME__/.airdrop-agent/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.airdrop-agent/logs/launchd.err.log</string>
  <key>ThrottleInterval</key><integer>30</integer>
</dict>
</plist>
